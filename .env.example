# MongoDB Atlas or Local Replica Set Connection String
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/transit_smart_assist?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27017/transit_smart_assist?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=transit_smart_assist

# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Commuter and Admin Authentication
JWT_SECRET=transitsmartassist_super_secret_jwt_key_2025

# Gemini AI API Key (Optional)
# If provided, Gemini Flash provides live natural language route reasoning and text-embedding-004 generates query embeddings.
# If omitted or unavailable, the system uses built-in deterministic heuristic reasoning without breaking any MongoDB feature.
GEMINI_API_KEY=

# CORS Configuration
CLIENT_URL=http://localhost:3000
